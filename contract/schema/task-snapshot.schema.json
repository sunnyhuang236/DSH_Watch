{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://dsh-mobile-watch.local/schema/task-snapshot.schema.json",
  "title": "TaskSnapshot",
  "description": "M1 契约 v1.0（冻结）：一个 DSH 会话 = 一个任务；run_id 对应 DSH turn。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "task_id", "run_id", "state", "state_version", "title", "summary",
    "started_at", "updated_at", "last_activity_at", "ended_at", "capabilities", "cost",
    "token_usage", "agent_count", "agent_state", "connection", "delegation_depth",
    "parent_task_id", "origin", "current_step", "current_tool", "waiting"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "task_id": { "type": "string", "minLength": 1, "description": "DSH session id，如 session-<uuid> 或子代理 <uuid>" },
    "run_id": { "type": ["string", "null"], "description": "task_id + ':' + DSH turn" },
    "state": { "enum": ["unknown", "running", "waiting_input", "waiting_approval", "succeeded", "failed", "cancelled"] },
    "state_version": { "type": "integer", "minimum": 0 },
    "title": { "type": ["string", "null"], "maxLength": 120 },
    "summary": { "type": ["string", "null"], "maxLength": 200 },
    "started_at": { "type": ["integer", "null"], "description": "epoch ms；当前 run 开始时间" },
    "updated_at": { "type": "integer", "description": "epoch ms；最近一次写入" },
    "last_activity_at": { "type": ["integer", "null"], "description": "epoch ms；最近语义活动时间" },
    "ended_at": { "type": ["integer", "null"], "description": "epoch ms；当前 run 终态时间" },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["approval", "cost", "agents"],
      "properties": {
        "approval": { "type": "boolean" },
        "cost": { "type": "boolean" },
        "agents": { "type": "boolean" }
      }
    },
    "cost": { "type": "null", "description": "M0 结论：DSH 只有 token，无金额/币种；固定 null" },
    "token_usage": {
      "anyOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["input_tokens", "output_tokens", "cache_read_tokens", "cache_write_tokens", "total_tokens", "messages"],
          "properties": {
            "input_tokens": { "type": "integer", "minimum": 0 },
            "output_tokens": { "type": "integer", "minimum": 0 },
            "cache_read_tokens": { "type": "integer", "minimum": 0 },
            "cache_write_tokens": { "type": "integer", "minimum": 0 },
            "total_tokens": { "type": "integer", "minimum": 0 },
            "messages": { "type": "integer", "minimum": 0 }
          }
        }
      ]
    },
    "agent_count": { "type": "integer", "minimum": 0, "description": "当前任务下的子代理数量（subagent/catalog 事件计数）" },
    "agent_state": { "enum": ["unknown", "idle", "running"], "description": "实时 agent/status；不是任务状态" },
    "connection": { "enum": ["online", "reconnecting", "offline", "unknown"] },
    "delegation_depth": { "type": "integer", "minimum": 0 },
    "parent_task_id": { "type": ["string", "null"] },
    "origin": { "type": ["string", "null"] },
    "current_step": { "type": ["integer", "null"] },
    "current_tool": { "type": ["string", "null"] },
    "waiting": {
      "anyOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "since"],
          "properties": {
            "kind": { "enum": ["input", "approval"] },
            "since": { "type": "integer" },
            "call_id": { "type": ["string", "null"] },
            "approval_id": { "type": ["string", "null"] },
            "tool_name": { "type": ["string", "null"] }
          }
        }
      ]
    }
  }
}
